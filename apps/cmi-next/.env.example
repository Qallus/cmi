# App
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# Supabase (server-side only — do NOT prefix with NEXT_PUBLIC_)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@constructedmatter.com

# Twilio — browser softphone (Voice SDK), SMS, recording, transcription
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+14809064400
# Optional: comma-separated list of all numbers selectable as "dial out from"
TWILIO_PHONE_NUMBERS=
# Optional: restrict which numbers may send SMS (defaults to first owned number)
TWILIO_SMS_NUMBERS=
# Required for the browser softphone (Voice SDK access tokens):
TWILIO_API_KEY_SID=SK...
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=AP...
# Set "true" to enforce x-twilio-signature validation on inbound webhooks
TWILIO_VALIDATE_WEBHOOK=false
# Legacy click-to-call bridge vars (no longer used by the softphone):
TWILIO_OUTBOUND_BRIDGE_NUMBER=
TWILIO_INBOUND_FORWARD_NUMBER=

# OpenAI — enables AI call transcription (Whisper). Optional.
OPENAI_API_KEY=
# UI flag only — set "true" once OPENAI_API_KEY is configured
NEXT_PUBLIC_OPENAI_CONFIGURED=false

# Hermes Agent Gateway (optional — internal tool)
# Run: hermes --profile dashboard-agent gateway run
HERMES_AGENT_URL=http://127.0.0.1:8787
HERMES_AGENT_API_KEY=
HERMES_AGENT_MODEL=hermes-agent

# xAI Voice Agent (Bolt AI) — powers the "Talk to Bolt AI" FAB on the public site.
# The server mints a short-lived ephemeral token; the browser never sees the API key.
XAI_API_KEY=
XAI_VOICE_AGENT_ID=agent_xmHtZr95yUMAPDUG

# Web Push (PWA push notifications). Generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must be a BUILD variable in Coolify (inlined into the
# client bundle); it is the public key, so exposing it is safe. The private key and
# subject are runtime-only secrets.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:jeremy@constructedmatter.com

# App
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# Supabase (server-side only — do NOT prefix with NEXT_PUBLIC_)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@constructedmatter.com

# Twilio SMS and click-to-call dialer
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_OUTBOUND_BRIDGE_NUMBER=
TWILIO_INBOUND_FORWARD_NUMBER=

# Hermes Agent Gateway (optional — internal tool)
# Run: hermes --profile dashboard-agent gateway run
HERMES_AGENT_URL=http://127.0.0.1:8787
HERMES_AGENT_API_KEY=
HERMES_AGENT_MODEL=hermes-agent
